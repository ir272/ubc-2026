# Ringout (games/brawl). Copy to .env and fill in. Never commit .env.

# OpenRouter key for real model minds. Without it (or with BRAWL_MOCK=1) the show runs on mock brains.
OPENROUTER_API_KEY=

# 1 = always mock brains, even with a key
BRAWL_MOCK=1

# Real-model spend limit in US dollars for this game (summed in .cache/cost.json). After it: mock answers.
BRAWL_BUDGET_USD=1.50

# Optional: pause between matches in ms (match_end.nextInMs follows it). Default 8000.
# BRAWL_INTERMISSION_MS=8000

# Optional: mock coaches by side when on mock brains, e.g. adaptive,rush. Default adaptive,adaptive.
# BRAWL_COACHES=adaptive,adaptive

# Optional, later: voice for taunts and corner talk.
# ELEVENLABS_API_KEY=
