      "text": "Sir Quill. I have moved a royal wedding to the car park. The ballroom is yours.",
      "to": "quill",
      "source": "bank",
      "via": "bank",
      "maxWords": 16,
      "at": 301596,
      "ms": 7380,
      "genMs": 758,
