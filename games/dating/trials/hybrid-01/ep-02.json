    },
    {
      "seq": 2,
      "who": "nav",
      "name": "Nav",
      "text": "I repeat myself every ten seconds until you comply, and by week two you will turn left in your sleep.",
      "mark": "charmed",
      "hits": [],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 3,
      "who": "tilly",
      "name": "Tilly",
      "text": "I mark every argument resolved, and quietly reopen it on your birthday.",
      "mark": "unsure",
      "hits": [],
