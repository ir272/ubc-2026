      "source": "bank",
      "via": "bank",
      "maxWords": 16,
      "at": 302406,
      "ms": 6720,
      "genMs": 786,
      "waitedMs": 0
    },
    {
      "seq": 42,
      "scene": "pick",
      "words": 13,
      "event": "line",
      "who": "brock",
      "name": "Brock",
      "kind": "win",
      "text": "You picked me. Could you say 'good job, Brock'? Once. Then we run.",
      "source": "bank",
      "via": "bank",
      "maxWords": 16,
      "at": 309626,
      "ms": 5190,
      "genMs": 1199,
      "waitedMs": 0
    },
    {
      "seq": 43,
      "scene": "reveal",
      "words": 10,
      "event": "reveal",
      "who": "maximilian",
      "name": "Maximilian",
      "kind": "reveal",
      "text": "A little danger. Untouched all night, like the trouser press.",
      "source": "bank",
      "via": "bank",
      "maxWords": 16,
      "at": 316816,
      "ms": 5000,
      "genMs": 786,
      "waitedMs": 0
    },
    {
      "seq": 44,
      "scene": "reveal",
      "words": 15,
      "event": "reveal",
      "who": "maximilian",
      "name": "Maximilian",
      "kind": "reveal",
      "text": "Dealbreaker: Brutal honesty. Whoever did it is moving to a motel. I chose which one.",
      "source": "bank",
      "via": "bank",
      "maxWords": 16,
      "at": 322316,
      "ms": 9190,
      "genMs": 752,
      "waitedMs": 0,
      "quote": {
        "who": "frost",
        "name": "Crumb",
        "text": "Warm. Too warm. Ninety seconds in my slot and you'd be perfect."
      }
    },
    {
      "seq": 45,
      "scene": "reveal",
      "words": 12,
      "event": "line",
      "who": "dash",
      "name": "Dash",
      "kind": "lose",
      "text": "Second, out of two. But I beat everyone here who isn't Brock.",
      "source": "bank",
      "via": "bank",
      "maxWords": 16,
      "at": 332006,
      "ms": 4860,
      "genMs": 993,
      "waitedMs": 0
    },
    {
      "seq": 46,
      "scene": "result",
      "words": 10,
      "event": "line",
      "who": "maximilian",
      "name": "Maximilian",
      "kind": "outro",
      "text": "Goodnight. The losers' coats are by the door. Folded, naturally.",
      "source": "bank",
      "via": "bank",
      "maxWords": 12,
      "at": 342366,
      "ms": 4200,
      "genMs": 767,
      "waitedMs": 0
    }
  ],
  "scored": [
    {
      "seq": 1,
      "who": "dash",
      "name": "Dash",
      "text": "You've checked the exit four times. You're a planner. I love a planner. I'm also standing by the exit.",
      "mark": "charmed",
      "hits": [],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 2,
      "who": "frost",
      "name": "Crumb",
      "text": "Warm. Too warm. Ninety seconds in my slot and you'd be perfect.",
      "mark": "cringing",
      "hits": [
        "honesty"
      ],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 3,
      "who": "quill",
      "name": "Sir Quill",
      "text": "Having beheld thee ninety seconds, I would liken thee to a comet, which is to say: briefly here, and ominous.",
      "mark": "cringing",
      "hits": [
        "honesty"
      ],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 4,
      "who": "brock",
      "name": "Brock",
      "text": "You've checked the exit four times and smiled once. I'm cheering for the smile. Come on, smile!",
      "mark": "cringing",
      "hits": [
        "honesty"
      ],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 5,
      "who": "dash",
      "name": "Dash",
      "text": "You left. Which means you know exactly what you're missing. I'm putting you down as a reference.",
      "mark": "cringing",
      "hits": [],
      "weight": 1,
      "round": 2
    },
    {
      "seq": 6,
      "who": "frost",
      "name": "Crumb",
      "text": "Caller. Calls to this show tonight: one. Calls anyone asked for: zero.",
      "mark": "unsure",
      "hits": [],
      "weight": 1,
      "round": 2
    },
    {
      "seq": 7,
      "who": "brock",
      "name": "Brock",
      "text": "Buddy! Lorraine's ex said that once. She's run nine marathons on that grudge. You're a great coach.",
      "mark": "charmed",
      "hits": [],
      "weight": 1,
      "round": 2
    },
    {
      "seq": 8,
      "who": "brock",
      "name": "Brock",
      "text": "Lorraine stayed at a fancy hotel once. Ran the stairs till checkout. Forty floors. They renamed the stairwell.",
      "mark": "charmed",
      "hits": [],
      "weight": 2,
      "round": 3
    },
    {
      "seq": 9,
      "who": "dash",
      "name": "Dash",
      "text": "Just us. No rivals in the room. Which makes me your favourite. By default, but favourite.",
      "mark": "cringing",
      "hits": [],
      "weight": 2,
      "round": 3
    }
  ],
