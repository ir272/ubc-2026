      "words": 14,
      "event": "line",
      "who": "tilly",
      "name": "Tilly",
      "kind": "duo",
      "text": "Maximilian, policy lets me give one compliment per call. I've saved up four years.",
      "to": "maximilian",
      "source": "bank",
      "via": "bank",
      "maxWords": 20,
      "at": 230738,
      "ms": 5040,
      "genMs": 2409,
