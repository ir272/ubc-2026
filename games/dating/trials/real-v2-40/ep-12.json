    },
    {
      "seq": 45,
      "scene": "oneonone",
      "words": 13,
      "event": "reaction",
      "who": "maximilian",
      "name": "Maximilian",
      "kind": "duo",
      "text": "Mr Brock, what is the quietest thing you have ever done? Whisper it.",
      "to": "brock",
      "mark": "cringing",
      "hits": [
        "numbers"
      ],
      "source": "bank",
      "via": "bank",
      "spoken": true,
