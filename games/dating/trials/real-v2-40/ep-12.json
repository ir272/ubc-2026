      "genMs": 1025,
      "waitedMs": 0
    },
    {
      "seq": 43,
      "scene": "oneonone",
      "words": 17,
      "event": "line",
      "who": "tilly",
      "name": "Tilly",
      "kind": "duo",
      "text": "Just one, sir. The towels were too soft. I've apologised to every other towel in the country.",
      "to": "maximilian",
      "source": "bank",
      "via": "bank",
      "maxWords": 20,
      "at": 241008,
      "ms": 5970,
      "genMs": 523,
      "waitedMs": 0
    },
    {
      "seq": 44,
      "scene": "oneonone",
      "words": 15,
      "event": "line",
      "who": "brock",
      "name": "Brock",
      "kind": "duo",
      "text": "Whatever Tilly gave you, I brought snacks! Boiled eggs! Eleven! Still warm from my POCKET!",
      "to": "maximilian",
      "source": "bank",
      "via": "bank",
      "maxWords": 20,
      "at": 248308,
      "ms": 5350,
      "genMs": 488,
