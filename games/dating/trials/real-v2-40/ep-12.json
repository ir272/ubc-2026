      "words": 12,
      "event": "line",
      "who": "maximilian",
      "name": "Maximilian",
      "kind": "compare",
      "text": "Tilly would help me hide something; Brock would ask what it was.",
      "source": "bank",
      "via": "bank",
      "maxWords": 12,
      "at": 266205,
      "ms": 4420,
      "genMs": 706,
      "waitedMs": 0
    },
