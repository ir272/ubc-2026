      "words": 13,
      "event": "reaction",
      "who": "maximilian",
      "name": "Maximilian",
      "kind": "duo",
      "text": "Miss Tilly, you have stayed a week without one complaint; make one now.",
      "to": "tilly",
      "mark": "cringing",
      "hits": [
        "rules",
        "numbers"
      ],
      "source": "bank",
      "via": "bank",
