      "event": "reveal",
      "who": "maximilian",
      "name": "Maximilian",
      "kind": "reveal",
      "text": "Numbers and stats. I once had a bishop removed for that. He was mid-sentence.",
      "source": "bank",
      "via": "bank",
      "maxWords": 16,
      "at": 323148,
      "ms": 9200,
      "genMs": 825,
