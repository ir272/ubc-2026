  "scored": [
    {
      "seq": 1,
      "who": "quill",
      "name": "Sir Quill",
      "text": "Why I, of all who stand before thee, plumed and polished, hopeful, glinting in the lamplight? Height.",
      "mark": "charmed",
      "hits": [
        "confidence"
      ],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 2,
      "who": "prince",
      "name": "Prince",
      "text": "They are offering charm. I am offering a duchy. Kindly compare the brochures.",
      "mark": "unsure",
      "hits": [],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 3,
      "who": "brock",
      "name": "Brock",
      "text": "Why me? Ask Denise. Eighty-one, deadlifts her grandson. Grandson's forty-four. He books it weekly.",
      "mark": "cringing",
      "hits": [
        "numbers"
      ],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 4,
      "who": "dash",
      "name": "Dash",
      "text": "Three of them, one of me. I'm the rare one. Basic supply and demand.",
      "mark": "cringing",
      "hits": [
        "confidence",
        "numbers"
      ],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 5,
      "who": "quill",
      "name": "Sir Quill",
      "text": "Prince is truly royal, fair one. I know, for I have paid his processing fee. It is processing.",
      "mark": "charmed",
      "hits": [
        "confidence"
      ],
      "weight": 1,
      "round": 2
    },
    {
      "seq": 6,
      "who": "dash",
      "name": "Dash",
      "text": "Quill writes you a poem a day and never finishes one. So technically the love never ends. Exhausting.",
      "mark": "unsure",
      "hits": [],
      "weight": 1,
      "round": 2
    },
    {
      "seq": 7,
      "who": "prince",
      "name": "Prince",
      "text": "Congratulations, you have won one Dash. Lightly used. Pivots on contact. No returns.",
      "mark": "charmed",
      "hits": [],
      "weight": 1,
      "round": 2
    },
    {
      "seq": 8,
      "who": "prince",
      "name": "Prince",
      "text": "Alone at last. Your briefing for Saturday's banquet: never sit beside the Duke. He proposes.",
      "mark": "charmed",
      "hits": [
        "confidence"
      ],
      "weight": 2,
      "round": 3
    },
    {
      "seq": 9,
      "who": "quill",
      "name": "Sir Quill",
      "text": "Now, with the knaves dismissed, the candles low, and nothing between us but this helm, hello.",
      "mark": "cringing",
      "hits": [],
      "weight": 2,
      "round": 3
    }
  ],
