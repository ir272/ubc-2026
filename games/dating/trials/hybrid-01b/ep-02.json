      "name": "Prince",
      "text": "Dash. He is me with a pitch deck. The market cannot support two of us.",
      "mark": "cringing",
      "hits": [],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 3,
      "who": "nav",
      "name": "Nav",
      "text": "Pixel asked me to point at who goes home first, on camera, no whispering.",
      "mark": "cringing",
