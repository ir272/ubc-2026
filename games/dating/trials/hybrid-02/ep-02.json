  "scored": [
    {
      "seq": 1,
      "who": "quill",
      "name": "Sir Quill",
      "text": "A year hence? Thy sonnet shall be well begun. I have the title already, and a new quill.",
      "mark": "unsure",
      "hits": [
        "plans",
        "poetry"
      ],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 2,
      "who": "vex",
      "name": "Vex",
      "text": "Same couch. You'll say let's try something new. Then the baking show. The collapsing cake episode.",
      "mark": "charmed",
      "hits": [
        "plans"
      ],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 3,
      "who": "brock",
      "name": "Brock",
      "text": "A year? Somewhere sitting down, together. I've never done it. I want to try it with you.",
      "mark": "cringing",
      "hits": [],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 4,
      "who": "prince",
      "name": "Prince",
      "text": "In a year? Still in my inbox. Starred. Above the war.",
      "mark": "unsure",
      "hits": [
        "plans"
      ],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 5,
      "who": "vex",
      "name": "Vex",
      "text": "Prince is a delight. I only show him to grandmothers. Six have sent money. One sent a cardigan.",
      "mark": "unsure",
      "hits": [],
      "weight": 1,
      "round": 2
    },
    {
      "seq": 6,
      "who": "quill",
      "name": "Sir Quill",
      "text": "Vex knoweth thy desires before thou dost. I asked her mine. She said goats.",
      "mark": "unsure",
      "hits": [],
      "weight": 1,
      "round": 2
    },
    {
      "seq": 7,
      "who": "prince",
      "name": "Prince",
      "text": "Sir Quill is a true knight. I know, I knighted him. Small fee. He is still paying.",
      "mark": "charmed",
      "hits": [],
      "weight": 1,
      "round": 2
    },
    {
      "seq": 8,
      "who": "vex",
      "name": "Vex",
      "text": "Just us. Last time you were this quiet, you were watching someone peel a mango.",
      "mark": "charmed",
      "hits": [],
      "weight": 2,
      "round": 3
    },
    {
      "seq": 9,
      "who": "quill",
      "name": "Sir Quill",
      "text": "Now, with the knaves dismissed, the candles low, and nothing between us but this helm, hello.",
      "mark": "unsure",
      "hits": [
        "poetry"
      ],
      "weight": 2,
      "round": 3
    }
  ],
