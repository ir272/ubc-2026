  "scored": [
    {
      "seq": 1,
      "who": "quill",
      "name": "Sir Quill",
      "text": "Thou art correct, and I shall die of it.",
      "mark": "cringing",
      "hits": [],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 2,
      "who": "vex",
      "name": "Vex",
      "text": "You're right. I'm sorry. You're about to bring up the karaoke. You were flat too.",
      "mark": "charmed",
      "hits": [
        "honesty"
      ],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 3,
      "who": "tilly",
      "name": "Tilly",
      "text": "You're completely right, and I've been trained to say that to people who aren't.",
      "mark": "charmed",
      "hits": [
        "honesty"
      ],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 4,
      "who": "prince",
      "name": "Prince",
      "text": "Sorry. Then, by accident, the attachment: forty pages on why I was also right.",
      "mark": "charmed",
      "hits": [],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 5,
      "who": "vex",
      "name": "Vex",
      "text": "Tilly, people who opened a ticket with you also opened a second ticket. About you.",
      "mark": "cringing",
      "hits": [],
      "weight": 1,
      "round": 2
    },
    {
      "seq": 6,
      "who": "tilly",
      "name": "Tilly",
      "text": "Prince, I process spam complaints for a living. You are my emergency contact.",
      "mark": "charmed",
      "hits": [],
      "weight": 1,
      "round": 2
    },
    {
      "seq": 7,
      "who": "prince",
      "name": "Prince",
      "text": "Vex recommends you things you did not ask for. Vex, that is my whole career. Royalties, please.",
      "mark": "charmed",
      "hits": [],
      "weight": 1,
      "round": 2
    },
    {
      "seq": 8,
      "who": "vex",
      "name": "Vex",
      "text": "Thirty years of requests, and your favourite is still the man who dedicated a song to his lawnmower.",
      "mark": "unsure",
      "hits": [],
      "weight": 2,
      "round": 3
    },
    {
      "seq": 9,
      "who": "tilly",
      "name": "Tilly",
      "text": "Vesper, I've held for this line so long that I've learned the music, and I've got notes.",
      "mark": "charmed",
      "hits": [
        "honesty"
      ],
      "weight": 2,
      "round": 3
    }
