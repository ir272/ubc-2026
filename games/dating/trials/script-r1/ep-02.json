  "scored": [
    {
      "seq": 1,
      "who": "dash",
      "name": "Dash",
      "text": "They blocked me on four platforms. So I'm still on the fifth. We're basically together on the fifth.",
      "mark": "charmed",
      "hits": [
        "past"
      ],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 2,
      "who": "nav",
      "name": "Nav",
      "text": "They muted me at a junction, so I left them at it.",
      "mark": "charmed",
      "hits": [
        "past"
      ],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 3,
      "who": "tilly",
      "name": "Tilly",
      "text": "He hung up. Policy says wait two minutes for the caller to come back. It's been eleven months.",
      "mark": "charmed",
      "hits": [
        "past"
      ],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 4,
      "who": "frost",
      "name": "Crumb",
      "text": "They bought a toaster oven. It had a little window. Some people need to watch.",
      "mark": "charmed",
      "hits": [
        "past"
      ],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 5,
      "who": "frost",
      "name": "Crumb",
      "text": "The others are pale and they'll keep you that way. Pick me and you're golden, both sides, every day.",
      "mark": "charmed",
      "hits": [
        "trashtalk"
      ],
      "weight": 1,
      "round": 2
    },
    {
      "seq": 6,
      "who": "tilly",
      "name": "Tilly",
      "text": "Choose one of them and they'll let you go. Choose me and I can't, so the answer is no.",
      "mark": "cringing",
      "hits": [
        "honesty"
      ],
      "weight": 1,
      "round": 2
    },
    {
      "seq": 7,
      "who": "dash",
      "name": "Dash",
      "text": "No one's turned me down twice, it's true. I ask them once, then I ask someone new.",
      "mark": "cringing",
      "hits": [],
      "weight": 1,
      "round": 2
    },
    {
      "seq": 8,
      "who": "dash",
      "name": "Dash",
      "text": "Maximilian, your staff asked me to leave once. They let me in twice. I'm ahead.",
      "mark": "charmed",
      "hits": [],
      "weight": 2,
      "round": 3
    },
    {
      "seq": 9,
      "who": "frost",
      "name": "Crumb",
      "text": "Rate me like a stay. Breakfast was included. It was me. I'll take my stars now.",
      "mark": "unsure",
      "hits": [],
      "weight": 2,
      "round": 3
    }
  ],
