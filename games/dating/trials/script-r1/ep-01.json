  "scored": [
    {
      "seq": 1,
      "who": "dash",
      "name": "Dash",
      "text": "You've checked the exit four times. You're a planner. I love a planner. I'm also standing by the exit.",
      "mark": "cringing",
      "hits": [
        "numbers",
        "flattery"
      ],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 2,
      "who": "quill",
      "name": "Sir Quill",
      "text": "Thou art a rose. I know not what thou art.",
      "mark": "charmed",
      "hits": [
        "flattery"
      ],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 3,
      "who": "brock",
      "name": "Brock",
      "text": "Ninety seconds? You're a slow blinker and a fast judge and you've looked at my ears twice, which, thank you.",
      "mark": "cringing",
      "hits": [
        "numbers"
      ],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 4,
      "who": "nav",
      "name": "Nav",
      "text": "You are a small blue dot, facing the wrong way. Turn around. There. Me.",
      "mark": "charmed",
      "hits": [
        "confidence"
      ],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 5,
      "who": "quill",
      "name": "Sir Quill",
      "text": "Fie, voice in the wall. Thou hadst thy chance, and I have read thy chance, and it was prose.",
      "mark": "unsure",
      "hits": [],
      "weight": 1,
      "round": 2
    },
    {
      "seq": 6,
      "who": "nav",
      "name": "Nav",
      "text": "Your exit was three years ago and you missed it, so take the next one, in one hundred feet.",
      "mark": "cringing",
      "hits": [
        "numbers"
      ],
      "weight": 1,
      "round": 2
    },
    {
      "seq": 7,
      "who": "dash",
      "name": "Dash",
      "text": "You left. Which means you know exactly what you're missing. I'm putting you down as a reference.",
      "mark": "charmed",
      "hits": [
        "confidence"
      ],
      "weight": 1,
      "round": 2
    },
    {
      "seq": 8,
      "who": "dash",
      "name": "Dash",
      "text": "Just us. No rivals in the room. Which makes me your favourite. By default, but favourite.",
      "mark": "charmed",
      "hits": [
