  "scored": [
    {
      "seq": 1,
      "who": "prince",
      "name": "Prince",
      "text": "I write you a short email. No attachments, no offers. It takes me four days.",
      "mark": "cringing",
      "hits": [],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 2,
      "who": "dash",
      "name": "Dash",
      "text": "I wait in the hall. Every time I leave a room, people cheer up. It's a gift.",
      "mark": "charmed",
      "hits": [],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 3,
      "who": "quill",
      "name": "Sir Quill",
      "text": "I read to thee. In my experience, a lady who waketh foul leaveth delighted. Quickly, too.",
      "mark": "unsure",
      "hits": [],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 4,
      "who": "frost",
      "name": "Crumb",
      "text": "Foul moods this year: 31. Wednesdays: 30. Quit the choir.",
      "mark": "cringing",
      "hits": [
        "honesty"
      ],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 5,
      "who": "prince",
      "name": "Prince",
      "text": "Dear ex, you have been filed as low priority. Just below the succession crisis.",
      "mark": "cringing",
      "hits": [],
      "weight": 1,
      "round": 2
    },
    {
      "seq": 6,
      "who": "dash",
      "name": "Dash",
      "text": "You said I'd end up alone. I'm on a dating show with five people. Worst prediction ever.",
      "mark": "charmed",
      "hits": [],
      "weight": 1,
      "round": 2
    },
    {
      "seq": 7,
      "who": "quill",
      "name": "Sir Quill",
      "text": "Fie, voice in the wall. Thou hadst thy chance, and I have read thy chance, and it was prose.",
      "mark": "cringing",
      "hits": [],
      "weight": 1,
      "round": 2
    },
    {
      "seq": 8,
      "who": "quill",
      "name": "Sir Quill",
      "text": "Thy face is a little window with a battle in it. Pray, which side are we on?",
      "mark": "charmed",
      "hits": [],
      "weight": 2,
      "round": 3
    },
    {
      "seq": 9,
      "who": "dash",
      "name": "Dash",
      "text": "Pixel, your chat said my name eleven times. Mostly asking who I was. Still. Eleven.",
      "mark": "cringing",
      "hits": [],
      "weight": 2,
      "round": 3
    }
