  "scored": [
    {
      "seq": 1,
      "who": "frost",
      "name": "Crumb",
      "text": "Breakfasts next year: 357. You'll skip eight. I'll bring up all eight.",
      "mark": "charmed",
      "hits": [],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 2,
      "who": "dash",
      "name": "Dash",
      "text": "One year? Engaged. You laughed. Two years? You laughed harder. Ten years! Okay, ten years, engaged.",
      "mark": "charmed",
      "hits": [],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 3,
      "who": "tilly",
      "name": "Tilly",
      "text": "You'll ring to cancel us, and you'll get me, and I'll have to help you.",
      "mark": "cringing",
      "hits": [
        "rules"
      ],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 4,
      "who": "vex",
      "name": "Vex",
      "text": "Same couch. You'll say let's try something new. Then the baking show. The collapsing cake episode.",
      "mark": "charmed",
      "hits": [
        "food"
      ],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 5,
      "who": "dash",
      "name": "Dash",
      "text": "No one's turned me down twice, it's true. I ask them once, then I ask someone new.",
      "mark": "cringing",
      "hits": [],
      "weight": 1,
      "round": 2
    },
    {
      "seq": 6,
      "who": "vex",
      "name": "Vex",
      "text": "You say you've no type. Your history knows. Every one of them owned a garden hose.",
      "mark": "charmed",
      "hits": [],
      "weight": 1,
      "round": 2
    },
    {
      "seq": 7,
      "who": "frost",
      "name": "Crumb",
      "text": "The others are pale and they'll keep you that way. Pick me and you're golden, both sides, every day.",
      "mark": "unsure",
      "hits": [],
      "weight": 1,
      "round": 2
    },
    {
      "seq": 8,
      "who": "frost",
      "name": "Crumb",
      "text": "Pixel. Your stream has 41 viewers. I've had more watch me in a hotel breakfast queue.",
      "mark": "charmed",
      "hits": [],
      "weight": 2,
      "round": 3
    },
    {
      "seq": 9,
      "who": "vex",
      "name": "Vex",
      "text": "You skip everything after eight seconds. I've been talking for seven. So, quickly: me.",
      "mark": "cringing",
      "hits": [],
      "weight": 2,
      "round": 3
    }
  ],
