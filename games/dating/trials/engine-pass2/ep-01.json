    },
    {
      "seq": 2,
      "who": "nav",
      "name": "Nav",
      "text": "You brake before every compliment, Vesper, which is how I know to accelerate.",
      "mark": "cringing",
      "hits": [
        "honesty"
      ],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 3,
      "who": "dash",
      "name": "Dash",
      "text": "You've checked the exit four times. You're a planner. I love a planner. I'm also standing by the exit.",
      "mark": "unsure",
      "hits": [],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 4,
      "who": "quill",
      "name": "Sir Quill",
      "text": "Thou art a rose. I know not what thou art.",
      "mark": "cringing",
      "hits": [
        "honesty"
      ],
      "weight": 1,
      "round": 1
    },
    {
      "seq": 5,
      "who": "quill",
      "name": "Sir Quill",
      "text": "Dash is as promising as a tulip in sixteen thirty-seven. Much admired. Briefly. Then worth an onion.",
