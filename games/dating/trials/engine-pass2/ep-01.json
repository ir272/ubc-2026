      "weight": 1,
      "round": 2
    },
    {
      "seq": 6,
      "who": "nav",
      "name": "Nav",
      "text": "Sir Quill is a fine choice, Vesper, if you have always wanted to arrive in the wrong century.",
      "mark": "cringing",
      "hits": [],
      "weight": 1,
      "round": 2
    },
    {
      "seq": 7,
      "who": "dash",
      "name": "Dash",
      "text": "Nav will always know where you are. Always. I pitched that as a feature. It tested as a threat.",
      "mark": "cringing",
      "hits": [
        "honesty"
      ],
      "weight": 1,
      "round": 2
    },
    {
      "seq": 8,
      "who": "dash",
      "name": "Dash",
      "text": "Vesper, every song you play is four minutes. What if it was one? Same feelings. Four times the songs.",
      "mark": "unsure",
      "hits": [],
      "weight": 2,
      "round": 3
    },
    {
      "seq": 9,
      "who": "quill",
      "name": "Sir Quill",
      "text": "O lady of the singing box, who granteth wishes after midnight like a well, I wish thee.",
      "mark": "charmed",
