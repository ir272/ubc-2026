{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "paths": {
      "@games/*": ["../games/*"],
      "@solana/web3.js": ["../program/sdk/node_modules/@solana/web3.js"],
      "@solana/spl-token": ["../program/sdk/node_modules/@solana/spl-token"],
      "buffer": ["../program/sdk/node_modules/buffer"]
    }
  },
  "include": ["src"]
}
